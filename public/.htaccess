# Self-hosted GeoJSON needs an explicit type so Apache compresses the London map.
<IfModule mod_mime.c>
  AddType application/geo+json .geojson
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/geo+json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Revalidate mutable entry points/data while retaining old hashed assets for open tabs.
  <FilesMatch "\.(html|json|geojson|csv)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
